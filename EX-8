class Parent:
    def vehicle(self):
        print("Vehicles")


class Child1(Parent):
    brand = "Thar"
    model = "4x4"

    def car(self):
        print("Cars")
        print("Brand:", self.brand)
        print("Model:", self.model)


class Child2(Parent):
    brand = "Royal Enfield"
    model = "350"

    def bike(self):
        print("Bikes")
        print("Brand:", self.brand)
        print("Model:", self.model)


c1 = Child1()
c2 = Child2()

c1.car()
c2.bike()
